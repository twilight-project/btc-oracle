# Discord Webhook URL (get from Discord: Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=""

# Log files to monitor
# Format: "file_path|grep_pattern|label"
#   - file_path: absolute path to the log file
#   - grep_pattern: regex pattern to match (use "." to match all lines)
#   - label: short name shown in Discord messages
#
# Add as many MONITOR_FILES entries as you need:
MONITOR_FILES=(
    "/var/log/btc-oracle.log|[Ee][Rr][Rr][Oo][Rr]|btc-oracle-stdout"
    "/var/log/btc-oracle-error.log|.|btc-oracle-stderr"
    # "/var/log/forkscanner.log|[Ee][Rr][Rr][Oo][Rr]|forkscanner-stdout"
    # "/var/log/forkscanner-error.log|.|forkscanner-stderr"
)

# Polling interval in seconds
POLL_INTERVAL=10

# Max message length for Discord (2000 char limit)
MAX_MSG_LENGTH=1900

# Server name (shown in Discord messages)
SERVER_NAME="production-server"

# Node identifier (shown in Discord messages)
NODE_NAME="btc-oracle-judge"
